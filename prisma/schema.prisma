// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  name      String
  email     String   @unique
  imageUrl  String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Persistent active-organization reference (multi-org support).
  // Validated against OrganizationMember on every use.
  // Optional FK so deleting/switching orgs never deletes the user.
  activeOrganizationId String?
  activeOrganization   Organization? @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  trialCreditsGrantedAt DateTime?

  githubAccessToken String? // encrypted GitHub OAuth token, never sent to client
  githubUsername    String?
  githubUserId      String?
  githubConnectedAt DateTime?

  createdWorkspaces Workspace[] @relation("WorkspaceCreatedBy")
  memberships OrganizationMember[]
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  // Clerk Organization id (B-variant: Clerk owns identity/membership/billing,
  // Prisma mirrors + owns app data). Null until backfilled.
  clerkOrgId String? @unique
  plan      String   @default("free") // free | starter | pro — synced from Clerk org subscription via webhook
  credits   Int      @default(0) // trials are allocated once per user, never per org
  billingBaselineAt DateTime @default(now())
  billingBaselinePlan String @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   OrganizationMember[]
  workspaces Workspace[]
  activeForUsers User[] @relation("ActiveOrganization")
  creditGrants OrganizationCreditGrant[]

  @@index([plan])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(cuid())
  title     String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User         @relation("WorkspaceCreatedBy", fields: [createdById], references: [id])
  messages  Json     @default("[]")
  fileData  Json?
  revision  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  WorkspaceVersion[]
  githubPushTargets GithubPushTarget[]

  githubRepoUrl      String?
  githubRepoFullName String?
  githubBranch       String? // defaults to "main" on push
  lastPushedAt       DateTime?
  githubPushedFiles  Json? // repo-relative paths from the last successful push (for deletions)

  @@index([organizationId])
  @@index([createdById])
}

model WorkspaceVersion {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fileData    Json
  summary     String?
  createdAt   DateTime @default(now())

  @@index([workspaceId])
}

model OrganizationCreditGrant {
  id String @id @default(cuid())
  organizationId String
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key String
  credits Int
  createdAt DateTime @default(now())

  @@unique([organizationId, key])
}

// User-owned GitHub target history; never share deletion lists across targets.
model GithubPushTarget {
  id String @id @default(cuid())
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId String
  repoFullName String
  branch String
  repoUrl String
  pushedFiles Json
  lastPushedAt DateTime @default(now())

  @@unique([workspaceId, userId, repoFullName, branch])
}

// Distributed, expiring concurrency guard for serverless AI requests.
model AiRunLease {
  key String @id
  token String
  expiresAt DateTime
}
